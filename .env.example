# Project Settings → Data API → API URL
# Garder uniquement https://TON-PROJET.supabase.co, sans /rest/v1.
SUPABASE_URL=

# Project Settings → API Keys → Secret Keys → API KEY (sb_secret_…)
# La clé JWT legacy service_role est également acceptée.
# Le nom de variable est conservé pour compatibilité. Ne jamais publier la clé.
SUPABASE_SERVICE_ROLE_KEY=
